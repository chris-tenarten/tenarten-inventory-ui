  "relevantFunctionDefinitions": [
    {
      "name": "create_pending_receivals_from_purchase_order(uuid,jsonb,text)",
      "bodyMd5": "92b4401f4c3b343ca6bf5b3dd1bff574",
      "definition": "CREATE OR REPLACE FUNCTION public.create_pending_receivals_from_purchase_order(p_issuance_id uuid, p_lines jsonb, p_actor text)\n RETURNS TABLE(pending_receival_id uuid, source_line_id uuid, source_line_number integer, creation_status text)\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'public'\nAS $function$begin return query select * from public.create_allocated_po_receivals(p_issuance_id,p_lines,p_actor); end$function$\n"
    },
    {
      "name": "has_app_capability(text)",
      "bodyMd5": "7e83083b79c3ba2a1b1b3e01c690386d",
      "definition": "CREATE OR REPLACE FUNCTION public.has_app_capability(p_capability text)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'public'\nAS $function$\n select exists(select 1 from public.app_users u where u.user_id=auth.uid() and u.is_active and\n   case when p_capability='postJobUpdate' and u.job_updates_post and not u.read_only then true\n        when p_capability='sample_labels.generate' then u.role='admin' or u.sample_labels_generate\n        when p_capability='production_blend.manage' then u.role='admin' or u.production_blend_manage\n        when u.read_only and p_capability='messaging.write' then u.messaging_write\n        when u.read_only and p_capability not in ('readOperationalData','viewIntake','previewOperationalDocuments','accessDevelopmentEnvironment') then false\n        else exists(select 1 from public.app_role_capabilities c where c.role=u.role and c.capability=p_capability) end);\n$function$\n"
    }
  ],
