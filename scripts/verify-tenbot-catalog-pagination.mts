await check('no selected existing identities issues no catalog query',async()=>{const f=fixture(),result=await createCallerInvoiceReader(f.caller).readCatalog!(signal(),[]);assert.deepEqual(result,{complete:true,standard:[],specialty:[]});assert.equal(f.reads.length,0);});
