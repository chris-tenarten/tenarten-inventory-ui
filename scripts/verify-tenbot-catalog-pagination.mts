 const handler=createAuthenticatedReceivalAgent({model:'OFFLINE — NO INFERENCE',now:()=>now,remainingUsd:()=>0,assertNoFatal(){},createProvider(){throw Error('No provider');},async decodeAttachment(){throw Error('No decode');},async extractDocument(){throw Error('No extraction');},sourceStore(){return {async get(){return clone(source);},async download(){throw Error('No download');},async record(input){source={...source,version:source.version+1,agentState:input.state};return clone(source);},async abandon(){throw Error('No abandon');}};}});
 const result=await handler({action:'review',draftId:sourceId,revision:1,edits:draft.rows.map(row=>({lineId:row.lineId,materialId:row.materialId,quantity:row.quantity,unit:row.unit,jobId:null,excluded:false})),orderDetails:draft.orderDetails},owner,f.caller) as {draft:LocalReceivalDraft};
 assert.equal(f.reads.length,1);assert.deepEqual(f.reads[0].ids,[TENBOT_CANARY_CATALOG_ID]);assert.equal(result.draft.rows[0].quantity,'1');assert.equal(result.draft.rows[0].unit,'Bag');assert.equal(result.draft.rows[0].materialId,'standard:'+TENBOT_CANARY_CATALOG_ID);assert.equal(result.draft.rows[0].quantityBasis?.receivalQuantity,'1');assert.equal(result.draft.canApprove,true);const prepare=f.rpcs.find(r=>r.name==='prepare_invoice_receival_draft_with_source')!;assert.equal((prepare.args.p_lines as Row[])[0].catalogId,TENBOT_CANARY_CATALOG_ID);assert(f.rpcs.every(r=>['has_app_capability','prepare_invoice_receival_draft_with_source'].includes(r.name)));assert.equal(result.draft.executionEnabled,false);
