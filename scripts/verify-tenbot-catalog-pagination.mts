await check('selected inputs reject duplicate identities, extraneous keys and morethan60 entries',async()=>{const f=fixture(),reader=createCallerInvoiceReader(f.caller),one:InvoiceCatalogIdentity={source:'standard',id:TENBOT_CANARY_CATALOG_ID};for(const refs of [[one,one],Array.from({length:61},(_,i)=>({source:'standard',id:id(i+1)})),[{...one,table:'jobs'}],[{source:'arbitrary_table',id:'1'}],[{source:'standard',id:''}]])await assert.rejects(reader.readCatalog!(signal(),refs as InvoiceCatalogIdentity[]),/invalid_invoice_catalog_identities/);assert.equal(f.reads.length,0);});
await check('stable counts and unique pages remain mandatory above1000 rows',async()=>{const expected:Partial<Record<Fault,string>>={missing_count:'missing_count',count_drift:'count_drift',empty_page:'incomplete',duplicate_id:'duplicate_id',query_error:'query_failed',throw:'query_failed',oversized_page:'unexpected_rows'};for(const [fault,reason] of Object.entries(expected))await fails(createCallerInvoiceReader(fixture({fault:fault as Fault}).caller).readCatalog!(signal()),reason);});
await check('host picker is bounded5000/source while model searches and duplicate reads retain1000 caps',async()=>{const large=Array.from({length:5001},(_,i)=>({...standard[0],id:id(i+1)}));await fails(createCallerInvoiceReader(fixture({standard:large}).caller).readCatalog!(signal()),'count_limit');const f=fixture(),reader=createCallerInvoiceReader(f.caller);await fails(reader.searchCatalog('Synthetic Material',signal()),'count_limit');await fails(reader.readReceivals(signal()),'count_limit');});
