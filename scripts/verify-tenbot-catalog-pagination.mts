await check('1951 standard +301 active specialty picker rows load completely in250-row pages',async()=>{const f=fixture(),read=await createCallerInvoiceReader(f.caller).readCatalog!(signal());assert.equal(read.complete,true);assert.equal(read.standard.length,1951);assert.equal(read.specialty.length,301);assert.equal(f.reads.filter(r=>r.table==='vendor_catalog').length,8);assert.equal(f.reads.filter(r=>r.table==='vendor_catalog_v2').length,2);assert(f.reads.filter(r=>r.table==='vendor_catalog_v2').every(r=>r.activeOnly));assert(f.reads.every(r=>!r.columns.match(/\b(price|notes|created_by)\b/)));});
await check('ordinary status preserves all2252 catalog choices and existing Job picker without inference',async()=>{const f=fixture(),result=await runtime(f)({action:'status'},id(90000),f.caller) as Row;assert.equal((result.catalog as Row[]).length,2252);assert.equal(result.executionEnabled,false);assert(f.reads.some(r=>r.table==='jobs'));assert(f.rpcs.every(r=>r.name==='has_app_capability'));});
