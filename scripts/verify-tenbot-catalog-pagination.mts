const checks:string[]=[];
async function check(name:string,run:()=>void|Promise<void>){await run();checks.push(name);}
function fixture(options:{standard?:Row[];specialty?:Row[];fault?:Fault;invisibleId?:string;jobError?:boolean}={}){
 const reads:Read[]=[],rpcs:{name:string;args:Row}[]=[];
 const caller:ReceivalAgentCaller={from(table:string){
  assert(['vendor_catalog','vendor_catalog_v2','pending_receivals','jobs'].includes(table));let columns='',start=0,end=249,ids:readonly string[]|undefined,activeOnly=false,term='';
  const query={select(value:string){columns=value;assert(!value.includes('*'));return query;},eq(key:string,value:unknown){assert.equal(key,'is_active');assert.equal(value,true);activeOnly=true;return query;},is(){return query;},in(key:string,values:readonly string[]){if(key==='id')ids=values;else assert.equal(key,'status');return query;},or(filter:string){const pattern=filter.match(/\.ilike\.("(?:\\.|[^"])*")/);if(pattern)term=String(JSON.parse(pattern[1])).replace(/^%|%$/g,'').toLowerCase();return query;},order(key:string){assert(['id','job_number'].includes(key));return query;},range(first:number,last:number){start=first;end=last;assert(last-first<250);return query;},limit(value:number){end=value-1;return query;},abortSignal(signal:AbortSignal){assert(!signal.aborted);return query;},then(resolve:(value:unknown)=>unknown,reject?:(error:unknown)=>unknown){
   const read={table,columns,start,end,ids,activeOnly};reads.push(read);
   if(table==='jobs')return Promise.resolve({data:options.jobError?null:[],count:0,error:options.jobError?{message:'PRIVATE DATABASE FAILURE'}:null}).then(resolve,reject);
   let source=table==='vendor_catalog'?(options.standard??standard):table==='vendor_catalog_v2'?(options.specialty??specialty):Array.from({length:1001},(_,i)=>({id:id(i+20001)}));
   const selection=ids;if(activeOnly)source=source.filter(row=>row.is_active===true);if(selection)source=source.filter(row=>selection.includes(String(row.id)));if(options.invisibleId)source=source.filter(row=>row.id!==options.invisibleId);if(term)source=source.filter(row=>Object.values(row).some(value=>typeof value==='string'&&value.toLowerCase().includes(term)));
   source=[...source].sort((a,b)=>String(a.id).localeCompare(String(b.id)));
   let data:Row[]=source.slice(start,end+1).map(row=>Object.fromEntries(columns.split(',').map(key=>[key,row[key]??null])));let count:number|null=source.length,error:unknown=null;
   if(table==='vendor_catalog'){
    if(options.fault==='missing_count')count=null;if(options.fault==='count_drift'&&start>0)count=source.length+1;if(options.fault==='empty_page'&&start>0)data=[];
    if(options.fault==='duplicate_id'&&start>0&&data.length)data[0]={...data[0],id:source[0].id};if(options.fault==='unexpected_id'&&data.length)data[0]={...data[0],id:'UNREQUESTED'};
    if(options.fault==='query_error')error={message:'PRIVATE DATABASE FAILURE',details:'private row'};if(options.fault==='throw')return Promise.reject(Error('PRIVATE DATABASE FAILURE')).then(resolve,reject);if(options.fault==='oversized_page')data=Array.from({length:251},(_,i)=>({...data[0],id:id(i+50000)}));
   }
   return Promise.resolve({data:clone(data),count,error}).then(resolve,reject);
  }};return query;
 },async rpc(name,args={}){rpcs.push({name,args});if(name==='has_app_capability')return {data:true,error:null};throw Error('Unexpected RPC '+name);}};
 return {caller,reads,rpcs};
}
const signal=()=>AbortSignal.timeout(5000);
async function fails(read:Promise<unknown>,reason:string){await assert.rejects(read,e=>e instanceof InvoiceReadError&&e.message==='invoice_read_incomplete'&&e.reason===reason);}
