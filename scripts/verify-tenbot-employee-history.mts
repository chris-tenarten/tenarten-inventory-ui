const history=(id?:string,before?:string)=>run()({action:'history',...(id?{conversationId:id}:{}),...(before?{before}:{})}) as Promise<History>;
const empty=await history(),id=empty.conversationId;assert(empty.turns.length===0);const first=await ask('How many Jobs are currently in Production?',id),original=String(first.message);assert(original.includes('8'));assert(first.persistentHistory);checks.push('Stable owner thread is discovered with no browser locator; completed answer is archived atomically');
assert.equal(previousAnswerNotice({error:'Live Job facts must be refreshed.'})?.kind,'legacy');
assert.equal(previousAnswerNotice({answer:{history:{state:'redacted',reason:'expired'}}})?.kind,'legacy');
