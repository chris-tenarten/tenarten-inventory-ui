assert.equal(previousAnswerNotice({error:'Live Job facts must be refreshed.',answer:{history:{state:'verified',persistent:true}}}),null);
checks.push('Legacy unavailable results, revoked access, retryable checks and readable persistent answers remain distinct without inferring permission from prose');
f.state.now+=2*86400000;f.tables.jobs[0].production_status='on_hold';const calls=f.state.providerCalls,restored=await history();assert.equal(restored.conversationId,id);assert(restored.turns.some(t=>t.answer.message===original&&t.answer.history.persistent&&t.answer.history.historical));assert.equal(f.state.providerCalls,calls);checks.push('Later-session discovery preserves original timestamps and readable historical values despite changed live status, without inference');
const list=await ask('Which Jobs are they?',id);assert(!String(list.message).includes('CTX-1 —')&&String(list.message).includes('CTX-8'));checks.push('Count subject survives later sessions while Which Jobs are they rereads current authorized population');
const named=await ask('What is the status of Job "Context Alpha"?',id);assert(String(named.message).includes('On Hold'));const labor=await ask('How many hours on that job?',id);assert(String(labor.message).includes('5 hours'));f.tables.manpower_entries[0].am_hours=4;const oldLabor=await history(id);assert(oldLabor.turns.some(t=>t.answer.message===labor.message));const currentLabor=await ask('How many hours on that job?',id);assert(String(currentLabor.message).includes('6 hours'));checks.push('Named Job and period persist; changed hours remain historical while new questions report fresh6hours');
const isolatedJob=await ask('What is the status of Job "Context Job 2"?',id);f.hidden.add(f.tables.jobs[0].id);const revoked=await history(id);assert(revoked.turns.filter(t=>t.answer.history.state==='verified').some(t=>t.answer.message===isolatedJob.message));assert(!JSON.stringify(revoked).includes(String(labor.message)));assert(!JSON.stringify(revoked).includes(original));checks.push('Record revocation selectively redacts affected aggregate/Job answers and identifying questions; unrelated Job answers remain');f.hidden.clear();
for(let i=0;i<22;i++)await ask('How many Jobs are currently in Production?',id);const latest=await history(id);assert.equal(latest.turns.length,20);assert(latest.nextCursor);const earlier=await history(id,latest.nextCursor!);assert(earlier.turns.length>0);assert(earlier.turns.some(t=>t.answer.message===original));assert(!earlier.turns.some(t=>latest.turns.some(x=>x.id===t.id)));assert((f.archives.get(id)?.length??0)>20);checks.push('Long-running transcript pages retain older answers beyond four/eight/twenty turns without feeding the archive to inference');
const firstRow=f.archives.get(id)![0].turn;assert(employeeDisplayValid(firstRow));const unavailable=await restoreEmployeePage([firstRow],{execute:f.state.jobTools!.execute,authorizeHistory:async()=>'unavailable'},firstRow.scopeDigest,id,f.state.now,async()=>true);assert.equal(unavailable[0].answer.message,'');const recovered=await restoreEmployeePage([firstRow],f.state.jobTools!,firstRow.scopeDigest,id,f.state.now,async()=>true);assert.equal(recovered[0].answer.message,original);checks.push('Unavailable authorization never publishes prose and does not destroy the private historical record');
const invalid=await restoreEmployeePage([firstRow],f.state.jobTools!,'a'.repeat(64),id,f.state.now,async()=>false);assert.equal(invalid[0].answer.message,'');assert.equal(invalid[0].question,'Previous private request');checks.push('Invalid source/contract evidence redacts both question and answer independently of data freshness');
for(const owner of ['22222222-2222-4222-8222-222222222222','33333333-3333-4333-8333-333333333333']){const other=createContextFixture(owner);other.rows.set(id,f.row(id));await assert.rejects(other.handler('https://tendev.pages.dev',{spendingAuthorized:false,persistentHistory:true})({action:'history',conversationId:id}),/unavailable|authorized/i);}checks.push('Cross-owner callers, including an otherwise fully capable account, cannot discover or hydrate another employee thread');
const raw=JSON.stringify(f.row(id).state);assert(!raw.includes(original)&&!raw.includes(String(labor.message)));assert((f.row(id).state.guidance.length??0)<=3);assert(!f.state.context.some(x=>JSON.stringify(x).includes(original)));checks.push('Durable visible history remains outside bounded model context and raw results');

await ask('What is the status of Job "Context Alpha"?',id);const beforeAccessFailure=structuredClone(f.row(id).state.context),originalTools=f.state.jobTools!;f.state.jobTools={...originalTools,authorizeHistory:async()=>'unavailable'};
try{await assert.rejects(history(id),/access could not be verified/);}finally{f.state.jobTools=originalTools;}
assert.deepEqual(f.row(id).state.context,beforeAccessFailure);await history(id);checks.push('Temporary context-authorization failure fails closed without deleting the privately retained subject');
