const primary=createTenbotAgentSessions({readOnlyHosted:true,mode:'openai',sessionStore:createTenbotAgentHistoryStore(f.caller,f.service,{persistent:true}),can:async()=>true,jobTools:()=>f.state.jobTools!,now:()=>f.state.now,provider:()=>({name:'Offline primary transport',model:'no-inference',async step(){step++;const usage={inputTokens:0,cachedInputTokens:0,outputTokens:0,costUsd:0,reservedUsd:0};if(step===1)return{calls:[{id:'d',name:'discover_capabilities',arguments:{names:['find_jobs','get_job_labor_summary']}}],continuation:[],usage};if(step===2)return{calls:[{id:'f',name:'find_jobs',arguments:{query:'Context Alpha',statuses:[],include_archived:false,limit:20,cursor:''}}],continuation:[],usage};if(step===3)return{calls:[{id:'l',name:'get_job_labor_summary',arguments:{job_id:f.tables.jobs[0].id,start_date:'2026-10-01',end_date:'2026-11-01'}}],continuation:[],usage};return{calls:[],continuation:[],usage,final:{answer:'Recorded labor: 6 hours.',observations:[{text:'Recorded labor: 6 hours.',evidence_ids:['e2']}],inferences:[],recommendations:[],questions:[],completed_actions:[]}};}})});
const primaryReply=await primary({action:'ask',question:'How many hours on that job?',conversationId:id},f.owner) as {message:string};assert(primaryReply.message.startsWith('CTX-1 — Context Alpha has 6 hours of recorded labor.'));checks.push('Primary multi-tool lookup and labor result receives the same concise deterministic quantitative presentation as fallback');
