async function validationGroups(before:Record<string,unknown>,migrationSha256:string){
 const negativeService=createClient(fixture.url,base.serviceRoleKey,{auth:{persistSession:false,autoRefreshToken:false},global:{fetch:async(input,init={})=>{const u=new URL(typeof input==='string'?input:input instanceof URL?input.href:input.url);assert.equal(u.origin,fixture.url);assert(['/rest/v1/rpc/activate_tenbot_chris_dev_canary_grant','/rest/v1/rpc/revoke_tenbot_chris_dev_canary_grant'].includes(u.pathname),'Negative service probe is fixed administrative metadata only');return boundedFetch(input,init);}}});
 let activeGrant:string|undefined,delayInstalled=false,passed=false;const created:string[]=[];
 const marker=500000+parseInt(run,16)%10000000,triggerName='tenbot_grant_delay_'+run;
 function removeDelay(){if(!delayInstalled)return;sql('remove-delay',`begin;drop trigger if exists ${triggerName} on public.invoice_receival_approvals;drop trigger if exists ${triggerName} on public.pending_receivals;drop function if exists public.${triggerName}();commit;`);delayInstalled=false;}
 function installApprovalDelay(draftId:string){assert(!delayInstalled);sql('approval-delay',`begin;create function public.${triggerName}() returns trigger language plpgsql security definer set search_path=pg_catalog,public as $$begin if new.owner_user_id='${subjectId}'::uuid and new.draft_id=${quote(draftId)}::uuid then perform pg_advisory_xact_lock(761030,${marker});perform pg_sleep(1.5);end if;return new;end$$;create trigger ${triggerName} before insert on public.invoice_receival_approvals for each row execute function public.${triggerName}();commit;`);delayInstalled=true;}
 function installExpiryDelay(grantId:string){assert(!delayInstalled);sql('expiry-delay',`begin;create function public.${triggerName}() returns trigger language plpgsql security definer set search_path=pg_catalog,public as $$declare deadline timestamptz;begin if auth.uid()='${subjectId}'::uuid and new.notes like ${quote('%'+documentReference+'%')} then select expires_at into strict deadline from public.tenbot_chris_dev_canary_grants where id=${quote(grantId)}::uuid;perform pg_advisory_xact_lock(761030,${marker});perform pg_sleep(greatest(0,extract(epoch from deadline-clock_timestamp()))+0.25);end if;return new;end$$;create trigger ${triggerName} before insert on public.pending_receivals for each row execute function public.${triggerName}();commit;`);delayInstalled=true;}
 async function waitForDelay(){const deadline=Date.now()+5000;while(Date.now()<deadline){const r=sql('delay-lock',`begin read only;select exists(select 1 from pg_locks where locktype='advisory' and classid=761030 and objid=${marker} and granted) as waiting;commit;`);if(r[0].waiting===true)return;await new Promise(resolve=>setTimeout(resolve,30));}throw Error('Bounded signed-request overlap was not observed');}
 async function finishGrant(){if(activeGrant){await revoke(activeGrant);activeGrant=undefined;}disableFixture();}
 const snapshot=()=>sql('state',`begin read only;select jsonb_build_object('activeGrants',(select count(*) from public.tenbot_chris_dev_canary_grants where owner_user_id='${subjectId}' and revoked_at is null and starts_at<=clock_timestamp() and expires_at>clock_timestamp()),'pending',(select count(*) from public.pending_receivals where notes like ${quote('%'+documentReference+'%')}),'executions',(select count(*) from public.invoice_receival_executions e join public.invoice_receival_drafts d on d.id=e.draft_id where e.owner_user_id='${subjectId}' and d.payload->'document'->>'sha256'='${documentSha}'),'grantRows',(select count(*) from public.tenbot_chris_dev_canary_grants),'auditRows',(select count(*) from public.tenbot_chris_dev_canary_grant_audit),'epoch',coalesce((select revision from public.invoice_receival_permission_epochs where scope='actor:${subjectId}'),0),'pilot',(select enabled from public.tenbot_receival_pilot_policy where singleton),'execution',(select execution_enabled from public.tenbot_receival_execution_control where singleton),'enrollments',(select count(*) from public.tenbot_receival_pilot_employees where user_id='${subjectId}'),'role',(select role from public.app_users where user_id='${subjectId}')) as state;commit;`)[0].state as Record<string,unknown>;
 const starting=snapshot();assert.equal(starting.activeGrants,0);assert.equal(starting.executions,0,'Completed fixed-document fixture proof exists; reuse evidence rather than recreate or delete it');assert.equal(starting.role,'developer');
 let revokedCase:Case|undefined;
 try{
  await group('default-off grant, genuine JWT identities, unchanged other roles and no direct private grant writes',async()=>{
   assert.equal(A.id,subjectId);assert.equal((await status(A)).active,false);assert.equal(await has(A,'adjustInventory'),false);assert.equal(await has(Other,'adjustInventory'),false);assert.equal(await has(Lead,'adjustInventory'),true);assert.equal(await has(Admin,'manageRolesPermissions'),true);
   for(const who of [Other,Lead,Admin])assert.equal((await status(who)).active,false,'No other employee receives subject permission');
   for(const who of [A,Other,Lead])await deny(who.client,'activate_tenbot_chris_dev_canary_grant',{p_expires_at:new Date(Date.now()+60000).toISOString(),p_reason:'unauthorized'});
   await deny(client(),'activate_tenbot_chris_dev_canary_grant',{p_expires_at:new Date(Date.now()+60000).toISOString(),p_reason:'anonymous'});
   await deny(negativeService,'activate_tenbot_chris_dev_canary_grant',{p_expires_at:new Date(Date.now()+60000).toISOString(),p_reason:'service is not employee Admin'});
   assert((await A.client.from('tenbot_chris_dev_canary_grants').insert({owner_user_id:subjectId,starts_at:new Date().toISOString(),expires_at:new Date(Date.now()+60000).toISOString(),reason:'forbidden',activated_by:A.id})).error);
   assert((await Admin.client.from('tenbot_chris_dev_canary_grant_audit').delete().eq('actor_user_id',Admin.id)).error);
   const attempt=await A.client.from('pending_receivals').insert({vendor:'T&M Supply',material_name:'Forbidden without grant',quantity_expected:1,quantity_received:0,unit:'Bag',status:'pending'});assert(attempt.error);
  });
  await group('activation rejects expired, over-15-minute and empty-reason requests without a row',async()=>{
   const prior=snapshot();for(const args of [{p_expires_at:new Date(Date.now()-1000).toISOString(),p_reason:'expired'},{p_expires_at:new Date(Date.now()+901000).toISOString(),p_reason:'too long'},{p_expires_at:new Date(Date.now()+60000).toISOString(),p_reason:''}])await deny(Admin.client,'activate_tenbot_chris_dev_canary_grant',args,['22023']);assert.equal(snapshot().grantRows,prior.grantRows);
  });
