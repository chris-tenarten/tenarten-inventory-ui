async function runValidation(){
 ownerOnly(privatePath);const actors=JSON.parse(readFileSync(privatePath,'utf8')) as PrivateActors;assert.equal(actors.fixtureRef,ref);assert.equal(actors.subject.id,subjectId);assert.equal(actors.purpose,'Synthetic isolated grant validation only; pinned UUID is a stand-in in another issuer/project');
