async function original(){if(sourceId)return sourceId;const bytes=new Uint8Array(readFileSync(pdfPath));assert.equal(hash(bytes),documentSha);const store=createInvoiceReceivalAttachmentService(A.client),source=await store.upload(new Blob([bytes],{type:'application/pdf'}),'synthetic-grant-validator.pdf');sourceId=source.id;assert.equal(source.sha256,documentSha);const downloaded=await store.download(source.id);assert.equal(hash(new Uint8Array(await downloaded.original.arrayBuffer())),documentSha);sourceRows[0].lineId=source.id+':L3';await createInvoiceReceivalSourceStateWriter(metadata).record({actorId:A.id,sourceId:source.id,expectedVersion:source.version,verifiedSha256:documentSha,state:{version:'invoice-receival-state.v1',originalSha256:documentSha,visionSha256:documentSha,rawLines,sourceRows,draft:null,traceHash:null,document:{id:source.id,filename:'synthetic-grant-validator.pdf',mediaType:'text/plain',synthetic:true,recordSource:'caller-authorized',text:rawLines.join('\n'),extraction:{mode:'deterministic-protected-test-fixture',model:'NO-INFERENCE grant validator',sourceMediaType:'application/pdf',sha256:documentSha}}}});return source.id;}
