type Signed={id:string;client:SupabaseClient;jwt:string};
const checks:{name:string;durationMs:number}[]=[];
async function group(name:string,test:()=>Promise<void>){phase=name;const then=Date.now();await test();checks.push({name,durationMs:Date.now()-then});save('grant-database-progress.json',{passedGroups:checks.length,checks,fixtureRef:ref});console.log(JSON.stringify({group:checks.length,name,passed:true}));}
async function signed(actor:SecretActor):Promise<Signed>{const entry=client();const result=await entry.auth.signInWithPassword({email:actor.email,password:actor.password});assert(!result.error&&result.data.session&&result.data.user?.id===actor.id,'Real synthetic Auth sign-in failed');assert((result.data.session.expires_at??0)*1000>Date.now()+180000,'Synthetic Auth session is too short for a grant-expiry test; stop without changing Auth configuration');const verification=await entry.auth.getUser(result.data.session.access_token);assert(!verification.error&&verification.data.user?.id===actor.id,'Synthetic JWT Auth verification failed');return{id:actor.id,client:client(result.data.session.access_token),jwt:result.data.session.access_token};}
async function call(c:SupabaseClient,name:string,args:Record<string,unknown>={}){const result=await c.rpc(name,args);assert(!result.error,'RPC '+name+' failed '+result.error?.code);return result.data as unknown;}
async function deny(c:SupabaseClient,name:string,args:Record<string,unknown>={},codes=['42501','PGRST202']){const result=await c.rpc(name,args);assert(result.error,'Expected rejection '+name);assert(codes.includes(result.error.code),'Unexpected denial '+name+' '+result.error.code);return result.error.code;}
