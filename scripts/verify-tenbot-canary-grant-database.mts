 assert.equal(prereqs.grantTable,true,'Apply reviewed candidate migration only to the isolated fixture first');assert.equal(prereqs.status,true);assert.equal(prereqs.executionOff,true);assert.equal(prereqs.pilotOff,true);assert.equal(prereqs.enrollments,0);
