let groups=0;const names:string[]=[];
async function test(name:string,run:()=>void|Promise<void>){await run();groups++;names.push(name);console.log('PASS '+name);}
async function rejected(call:Promise<unknown>,status?:number){await assert.rejects(call,(error:unknown)=>{assert(error instanceof Error);if(status!==undefined)assert.equal((error as Error&{status:number}).status,status);assert(!error.message.includes(png));return true;});}
function setup(options:{rawLines?:unknown;providerFailure?:boolean;onStep?:()=>Promise<void>}={}){
 let clock=Date.parse('2026-10-29T15:00:00Z'),calls=0,extractions=0,allowed=true;const deniedCapabilities=new Set<string>();
 let canHook:((capability:string)=>void)|undefined;
 const can=async(_owner:string,capability:string)=>{canHook?.(capability);return allowed&&!deniedCapabilities.has(capability);};
 const handler=createTenbotLiveDemo({model:'offline-transport-double',catalog:structuredClone(fixture.catalog),receivals:structuredClone(fixture.receivals),can,now:()=>clock,remainingUsd:()=>5,assertNoFatal(){},createProvider(_label,attachment){calls++;
  if(attachment)return {name:'offline extraction double',model:'offline',async step(request){extractions++;assert.equal(request.tools.length,0);assert.equal(request.maxOutputTokens,1800);assert(!request.instructions.includes('2 Bag'));if(options.providerFailure)throw Error('injected provider failure');return {calls:[],continuation:[],usage:emptyUsage(),final:{raw_lines:options.rawLines??fixture.document.text.split('\n')}};}} as AgentProvider;
  const scripted=createScriptedTenbotAgentProvider('invoice-preparation');return {...scripted,async step(request){await options.onStep?.();return scripted.step(request);}};
 }});
 const invoke=(body:Row,who=owner)=>handler(body,who) as Promise<Row>;
 const upload=(overrides:Row={})=>invoke({action:'upload',syntheticConfirmed:true,attachment:{filename:'approved-synthetic.png',mediaType:'image/png',dataBase64:png},...overrides});
 async function prepared(orderDetails?:unknown){const attached=await upload();const answer=await invoke({action:'ask',attachmentId:attached.attachmentId,question:'Create pending receivals for the materials on this invoice.',...(orderDetails?{orderDetails}:{})});return {attachmentId:attached.attachmentId as string,answer,draft:(answer.localDemo as {draft:DemoDraft}).draft};}
 const edits=(draft:DemoDraft)=>draft.rows.map(row=>({lineId:row.lineId,materialId:row.materialId,quantity:row.quantity,unit:row.unit,jobId:row.jobId,excluded:row.excluded||row.reasons.length>0,catalogRequest:row.catalogRequest??null}));
 async function reviewed(draft:DemoDraft,custom?:ReturnType<typeof edits>){return await invoke({action:'review',draftId:draft.id,revision:draft.revision,orderDetails:fixture.confirmedMetadataExample,edits:custom??edits(draft)}) as Row&{draft:DemoDraft};}
 const approve=(draft:DemoDraft,overrides:Row={})=>invoke({action:'approve',draftId:draft.id,revision:draft.revision,hash:draft.hash,confirmation:true,...overrides});
 return {invoke,upload,prepared,reviewed,edits,approve,calls:()=>calls,extractions:()=>extractions,setAllowed(value:boolean){allowed=value;},setCapability(capability:string,value:boolean){if(value)deniedCapabilities.delete(capability);else deniedCapabilities.add(capability);},advance(ms:number){clock+=ms;},setCanHook(hook:(capability:string)=>void){canHook=hook;}};
}
const violetRequest:ProposedCatalogMaterial={supplier:'T&M Supply',itemName:'Unlisted Violet',vendorSku:'UNK-99',materialType:'chip',size:'#2',unitSize:'50',unitSizeUom:'LB',packaging:'Bag',priceUnit:'Bag',notes:'Employee prepared from synthetic invoice; no catalog record exists.',prepared:true};
function addViolet(draft:DemoDraft,edits:ReturnType<ReturnType<typeof setup>['edits']>,request:ProposedCatalogMaterial=violetRequest){const source=draft.rows.find(row=>row.sourceText.includes('UNK-99'))!,edit=edits.find(row=>row.lineId===source.lineId)!;Object.assign(edit,{excluded:false,materialId:null,quantity:'4',unit:'Bag',catalogRequest:structuredClone(request)});return source;}

