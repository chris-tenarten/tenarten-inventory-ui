/** Focused real reference/JWT/RLS delta on the fixed isolated Free fixture.
 * No migrations, reset, history/Inventory writes, Production requests or inference. */
import assert from 'node:assert/strict';
import fs from 'node:fs';
import {randomBytes,randomUUID} from 'node:crypto';
import {execFileSync} from 'node:child_process';
import {createClient} from '@supabase/supabase-js';
import {createTenbotJobTools,type JobToolCaller,type JobToolResult} from '../supabase/functions/_shared/tenbot-job-tools';
import {contextFromReads,currentConversationContext,validConversationContext,type ConversationContext} from '../supabase/functions/_shared/tenbot-conversation-context';

const REF='jltgxcfiprocydhbrahz',CONFIG='/private/tmp/tenops-tenbot-hosted-adapter-20261029/free-project-credentials.private.json',HELPER='/private/tmp/tenops-tenbot-hosted-adapter-20261029/branch-query.mjs';
assert.deepEqual(process.argv.slice(2),['--isolated-free-fixture'],'Explicit isolated-fixture switch required');
const stat=fs.lstatSync(CONFIG);assert(stat.isFile()&&!stat.isSymbolicLink()&&(stat.mode&0o077)===0&&stat.uid===process.getuid?.(),'Owner-only existing fixture config required');
const cfg=JSON.parse(fs.readFileSync(CONFIG,'utf8'));assert(cfg.fixtureKind==='standalone-free'&&cfg.projectRef===REF&&cfg.branchRef===REF&&cfg.url==='https://'+REF+'.supabase.co','Fixed isolated Free fixture required');
const suffix=randomBytes(6).toString('hex'),marker='tenbot-resource-reference-20261101-'+suffix,DIR='/private/tmp/tenops-tenbot-resource-reference-20261101/database-'+suffix;
fs.mkdirSync(DIR,{recursive:true,mode:0o700});
const save=(name:string,value:unknown)=>fs.writeFileSync(DIR+'/'+name,JSON.stringify(value,null,2)+'\n',{mode:0o600,flag:'wx'}),quote=(v:string)=>"'"+v.replaceAll("'","''")+"'";
const actors=['member','admin'].map((role,i)=>({id:randomUUID(),role,email:'resource-'+randomUUID()+'@tenbot-fixture.example.invalid',password:'Synthetic-'+randomBytes(24).toString('base64url'),display:'Synthetic Reference '+suffix+' '+i}));
const jobs=Array.from({length:2},(_,i)=>({id:randomUUID(),number:'REF-'+suffix+'-'+(i+1),name:'Synthetic Reference '+suffix+' '+(i+1)})),laborId=randomUUID();
const scopePolicy='tenbot_ref_scope_'+suffix,revokePolicy='tenbot_ref_revoke_'+suffix,actorSql=actors.map(a=>quote(a.id)+'::uuid').join(','),jobSql=jobs.map(j=>quote(j.id)+'::uuid').join(',');
const checks:string[]=[],events:{caller:string;method:string;path:string}[]=[],deadline=Date.now()+180000,now=Date.parse('2026-11-01T18:00:00Z');
const attempted=new Set<string>(),created=new Set<string>();let serial=0,cleanup=false,seedAttempted=false;
save('actors.private.json',actors);save('scope.json',{fixture:REF,marker,roles:actors.map(a=>a.role),jobIds:jobs.map(j=>j.id),laborId,policies:[scopePolicy,revokePolicy],inferenceCalls:0,ProductionRequests:0});
function sql(name:string,query:string):Record<string,unknown>[] {
 const file=DIR+'/'+String(++serial).padStart(2,'0')+'-'+name+'.sql';
 query=query.replace(/^begin(?: read only)?;/i,v=>v+"set local lock_timeout='2s';set local statement_timeout='6s';");fs.writeFileSync(file,query,{mode:0o600,flag:'wx'});
 let raw:string;try{raw=execFileSync(process.execPath,[HELPER,'--file',file],{encoding:'utf8',timeout:12000,stdio:['ignore','pipe','pipe'],maxBuffer:1000000});}catch{throw Error('Bounded isolated SQL failed: '+name);}
 const result=JSON.parse(raw);assert(result.ok,'Isolated SQL rejected: '+name);return result.rows;
}
function dropPolicy(name:string){assert(/^tenbot_ref_(?:scope|revoke)_[a-f0-9]{12}$/.test(name));return `do $cleanup$ declare target oid;begin select oid into target from pg_policy where polrelid='public.jobs'::regclass and polname=${quote(name)};if target is not null then if obj_description(target,'pg_policy') is distinct from ${quote(marker)} then raise exception 'Task policy marker differs';end if;execute 'drop policy ${name} on public.jobs';end if;end $cleanup$;`;}
const paths=new Set(['/auth/v1/admin/users','/auth/v1/token','/auth/v1/user','/auth/v1/logout','/rest/v1/jobs','/rest/v1/production_rework_cycles','/rest/v1/manpower_entries','/rest/v1/rpc/has_app_capability','/rest/v1/rpc/tenbot_authorize_history_jobs']);
const fetcher=(caller:string):typeof fetch=>async(input,init)=>{assert(cleanup||Date.now()<deadline,'Focused fixture deadline');const url=new URL(String(input));assert.equal(url.origin,cfg.url,'No Production/external requests');assert(paths.has(url.pathname)||url.pathname.startsWith('/auth/v1/admin/users/'),'Unexpected fixture capability');events.push({caller,method:init?.method??'GET',path:url.pathname});assert(events.length<=(cleanup?184:160),'Focused request bound with reserved cleanup');return fetch(input,{...init,signal:AbortSignal.timeout(8000)});};
const client=(key=cfg.anonKey,caller='anonymous')=>createClient(cfg.url,key,{auth:{persistSession:false,autoRefreshToken:false,detectSessionInUrl:false},global:{fetch:fetcher(caller)}});
const service=client(cfg.serviceRoleKey,'fixture-setup'),clients:ReturnType<typeof client>[]=[],tools=(i:number)=>createTenbotJobTools(clients[i] as unknown as JobToolCaller,{deadlineMs:10000,now:()=>new Date(now)});
const restored=(value:ConversationContext,i=0)=>currentConversationContext(JSON.parse(JSON.stringify(value)),now+1000,tools(i),async()=>true,true);
function jobId(result:JobToolResult){assert(result.status==='ok'&&result.complete&&result.data&&'job' in result.data,'Exact authorized detail required');return result.data.job.job_id;}
function context(result:JobToolResult,args:Record<string,unknown>,question:string){const c=contextFromReads([{name:'find_jobs',args,result}],question,now);assert(c&&validConversationContext(c),'Strict v1 reference context required');return c;}

try{
 const pre=sql('preflight',`begin read only;select to_regprocedure('public.tenbot_conversation_context_valid(jsonb)') is not null as context_valid,to_regprocedure('public.tenbot_agent_state_valid(jsonb,uuid)') is not null as state_valid,(select relrowsecurity from pg_class where oid='public.jobs'::regclass) as job_rls,(select count(*) from public.jobs where id in(${jobSql}))::int as existing_jobs,(select count(*) from public.app_users where user_id in(${actorSql}))::int as existing_profiles,(select count(*) from pg_policy where polrelid='public.jobs'::regclass and polname in(${quote(scopePolicy)},${quote(revokePolicy)}))::int as existing_policies;commit;`)[0];
 assert(pre.context_valid&&pre.state_valid&&pre.job_rls&&pre.existing_jobs===0&&pre.existing_profiles===0&&pre.existing_policies===0,'Existing v1/RLS contracts and unused exact IDs required');
 for(const a of actors){attempted.add(a.id);const made=await service.auth.admin.createUser({id:a.id,email:a.email,password:a.password,email_confirm:true,user_metadata:{fixtureTask:marker}});if(made.error&&[400,401,403,404,422].includes(made.error.status??0))attempted.delete(a.id);assert(!made.error&&made.data.user?.id===a.id&&made.data.user.user_metadata.fixtureTask===marker,'Synthetic Auth creation failed');created.add(a.id);}
 seedAttempted=true;
 sql('seed-owned',`begin;insert into public.app_users(user_id,display_name,role,is_active,read_only) values ${actors.map(a=>`(${quote(a.id)},${quote(a.display)},${quote(a.role)},true,false)`).join(',')};insert into public.jobs(id,name,job_number,customer,production_status,material_status,planned_start,planned_end,archived_at) values ${jobs.map(j=>`(${quote(j.id)},${quote(j.name)},${quote(j.number)},'Synthetic','in_production','ready','2026-11-01','2026-11-10',null)`).join(',')};insert into public.manpower_entries(id,job_id,rework_cycle_id,work_date,am_hours,pm_hours,updated_at) values(${quote(laborId)},${quote(jobs[0].id)},null,'2026-11-01',3,2,now());create policy ${scopePolicy} on public.jobs as restrictive for select to authenticated using(auth.uid() not in(${actorSql}) or id in(${jobSql}));comment on policy ${scopePolicy} on public.jobs is ${quote(marker)};commit;`);
 for(const a of actors){const c=client(cfg.anonKey,a.role),r=await c.auth.signInWithPassword({email:a.email,password:a.password});assert(!r.error&&r.data.user?.id===a.id&&r.data.session,'Genuine synthetic sign-in required');const v=await c.auth.getUser();assert(!v.error&&v.data.user?.id===a.id,'Signed JWT identity verification failed');clients.push(c);}
 checks.push('Genuine synthetic Member/Admin JWTs use existing isolated capability/RLS contracts; setup key never reads operational tools');
 const args={query:jobs[0].number,include_archived:false,limit:20},single=await tools(0).execute('find_jobs',args),one=context(single,args,'Find Job '+jobs[0].number);
 assert.deepEqual(one.references,[jobs[0].id],'Singleton lookup must retain its returned canonical ID');
 const loaded=await restored(one);assert(loaded&&loaded.references[0]===jobs[0].id,'JSON-restored singleton identity must reauthorize');
 assert.equal(jobId(await tools(0).execute('get_job_planning',{job_id:loaded.references[0]})),jobs[0].id,'Planning must use canonical ID');
 const labor=await tools(0).execute('get_job_labor_summary',{job_id:loaded.references[0],start_date:'2026-11-01',end_date:'2026-11-01'});assert(jobId(labor)===jobs[0].id&&labor.data&&'total_hours' in labor.data&&labor.data.total_hours===5,'Fresh exact recorded labor required');
 checks.push('Actual singleton lookup survives JSON restoration/current authorization and drives exact planning plus deterministic5-hour labor without inference');
 const manyArgs={query:'Synthetic Reference '+suffix,include_archived:false,limit:20},many=context(await tools(0).execute('find_jobs',manyArgs),manyArgs,'Find Jobs matching Synthetic Reference '+suffix);
 assert.deepEqual([...many.references].sort(),jobs.map(j=>j.id).sort(),'Multiple bounded candidates must retain both IDs');assert((await restored(many))?.references.length===2,'Both retained candidates must reauthorize');
 const serialized=JSON.stringify([one,many]);assert(!serialized.includes(jobs[0].name)&&!serialized.includes('total_hours')&&!serialized.includes('planned_end'),'Retained context must not contain result facts');
 checks.push('Actual multi-candidate lookup retains bounded canonical choices without an arbitrary selected record or operational snapshot');
 const predicates=sql('strict-v1-context',`begin read only;select public.tenbot_conversation_context_valid(${quote(JSON.stringify(one))}::jsonb) and public.tenbot_conversation_context_valid(${quote(JSON.stringify(many))}::jsonb) as contexts_valid,public.tenbot_agent_state_valid(${quote(JSON.stringify({guidance:[],display:[],context:one}))}::jsonb,${quote(randomUUID())}::uuid) as state_valid;commit;`)[0];assert(predicates.contexts_valid&&predicates.state_valid,'Unchanged PostgreSQL v1 predicates must accept context');
 checks.push('Existing real PostgreSQL context/state validators accept the unchanged v1 selector shape; no migration applied');
 sql('revoke-owned-record',`begin;create policy ${revokePolicy} on public.jobs as restrictive for select to authenticated using(auth.uid()<>${quote(actors[0].id)}::uuid or id<>${quote(jobs[0].id)}::uuid);comment on policy ${revokePolicy} on public.jobs is ${quote(marker)};commit;`);
 const blocked=await tools(0).execute('get_job_planning',{job_id:loaded.references[0]});assert(blocked.data===null&&!blocked.complete,'Permission revoked after restoration must suppress exact detail');assert.equal(await restored(one),null,'Revoked reference must clear');assert.equal(await restored(many),null,'Revoked member of retained choices must clear');
 const raw=await clients[0].from('jobs').select('id').eq('id',jobs[0].id);assert(raw.error||raw.data?.length===0,'Direct REST cannot bypass record revocation');assert.equal(jobId(await tools(1).execute('get_job_planning',{job_id:jobs[0].id})),jobs[0].id,'Other genuine caller retains only its own authorized access');
 checks.push('Real actor-specific RLS revocation between restoration/detail denies facts and clears context while the separate Admin JWT remains scoped');
 sql('restore-record',`begin;${dropPolicy(revokePolicy)}commit;`);
 const afterRestore=await restored(one);assert(afterRestore,'Exact task policy removal restores genuine access');
 sql('revoke-owned-account',`begin;update public.app_users set is_active=false where user_id=${quote(actors[0].id)} and display_name=${quote(actors[0].display)};commit;`);
 const signed=await clients[0].auth.getUser();assert(!signed.error&&signed.data.user?.id===actors[0].id,'JWT must remain genuinely signed after current capability revocation');assert.equal(await restored(one),null,'Inactive caller cannot restore a reference');const denied=await tools(0).execute('get_job_planning',{job_id:afterRestore.references[0]});assert(denied.data===null&&!denied.complete,'Inactive caller cannot reuse the canonical seed');
 checks.push('Current account/capability revocation denies restoration and detail under the still-valid signed employee JWT');
 const anonymous=client(),anonymousTool=await createTenbotJobTools(anonymous as unknown as JobToolCaller,{deadlineMs:10000}).execute('get_job_planning',{job_id:jobs[0].id}),anonymousRaw=await anonymous.from('jobs').select('id').in('id',jobs.map(j=>j.id));assert(anonymousTool.data===null&&!anonymousTool.complete&&(anonymousRaw.error||anonymousRaw.data?.length===0),'Anonymous direct/tool access must be denied');
 checks.push('Unauthenticated direct REST and allowlisted tools reveal no synthetic Job facts');
 save('results.json',{passed:true,fixture:REF,groups:checks.length,checks,realPostgreSQL:true,genuineSignedJwtRls:true,syntheticIdentities:2,syntheticJobs:2,syntheticLaborEntries:1,modelInferenceCalls:0,ProductionRequests:0,inventoryWrites:0,assistantHistoryWrites:0,migrationsApplied:0,httpCalls:events.length});console.log(JSON.stringify({passed:true,groups:checks.length,fixture:REF,evidence:DIR,inferenceCalls:0}));
}catch(error){save('stop.json',{passed:false,checks,reason:error instanceof Error?error.message.split('\n')[0].slice(0,180):'Focused fixture stopped',ProductionRequests:0});throw Error('Focused reference database validation stopped; inspect owner-only evidence '+DIR);}
finally{
 cleanup=true;let recordsRemoved=!seedAttempted,authResolved=0,authRemoved=0,authAbsent=0;
 try{if(seedAttempted||created.size){const ownedJobs=jobs.map(j=>`(id=${quote(j.id)}::uuid and job_number=${quote(j.number)})`).join(' or '),profiles=actors.filter(a=>created.has(a.id)).map(a=>`(user_id=${quote(a.id)}::uuid and display_name=${quote(a.display)})`).join(' or ')||'false';
  const r=sql('cleanup-owned',`begin;${dropPolicy(revokePolicy)}${dropPolicy(scopePolicy)}delete from public.manpower_entries where id=${quote(laborId)}::uuid and job_id in(select id from public.jobs where ${ownedJobs});delete from public.jobs where ${ownedJobs};delete from public.app_users where ${profiles};select (select count(*) from public.jobs where ${ownedJobs})=0 and (select count(*) from public.manpower_entries where id=${quote(laborId)}::uuid)=0 and (select count(*) from public.app_users where ${profiles})=0 and (select count(*) from pg_policy where polrelid='public.jobs'::regclass and polname in(${quote(scopePolicy)},${quote(revokePolicy)}))=0 as removed;commit;`);recordsRemoved=r[0].removed===true;}}
 catch{save('cleanup-record-stop.json',{exactTaskCleanupNeeded:true,marker,jobIds:jobs.map(j=>j.id),laborId,actorIds:actors.map(a=>a.id),policies:[scopePolicy,revokePolicy],ProductionChanges:0});}
 for(const a of actors.filter(a=>attempted.has(a.id)))try{const found=await service.auth.admin.getUserById(a.id);if(found.error&&found.error.status===404){authAbsent++;authResolved++;continue;}if(found.data.user?.user_metadata.fixtureTask===marker){const gone=await service.auth.admin.deleteUser(a.id);if(!gone.error){authRemoved++;authResolved++;}}}catch{/* Never broaden exact task cleanup. */}
 save('cleanup.json',{taskRecordsRemoved:recordsRemoved,taskAuthUsersRemoved:authRemoved,taskAuthAlreadyAbsent:authAbsent,taskAuthIdentitiesResolved:authResolved,expectedAttemptedAuth:attempted.size,policyMarker:marker,priorFixtureReset:false,migrationsApplied:0,ProductionChanges:0});assert(recordsRemoved&&authResolved===attempted.size,'Exact isolated task cleanup remains required');
}
