// OFFLINE Responses/token-count doubles. No real key, network or inference.
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createOpenAIProvider,OPENAI_EXPERIMENT_PRICING} from '../supabase/functions/_shared/tenbot-openai';
import type {AgentStepRequest} from '../supabase/functions/_shared/tenbot-agent';
const checks:string[]=[],pdf=readFileSync(new URL('./fixtures/tenbot-invoice-live-demo.pdf',import.meta.url));
const request=():AgentStepRequest=>({instructions:'Read only the actual supplied original.',history:[{kind:'user',content:'Transcribe.'}],tools:[],finalSchema:{type:'object',properties:{ok:{type:'boolean'}},required:['ok'],additionalProperties:false},signal:AbortSignal.timeout(3000),maxOutputTokens:100,remainingUsd:.25,onReserve(){}});
const response=(patch:Record<string,unknown>={})=>new Response(JSON.stringify({model:'gpt-6.1-terra',service_tier:'default',status:'completed',usage:{input_tokens:20,output_tokens:5,input_tokens_details:{cached_tokens:0,cache_write_tokens:0},total_tokens:25},output:[{type:'message',role:'assistant',status:'completed',content:[{type:'output_text',text:'{"ok":true}'}]}],...patch}),{headers:{'Content-Type':'application/json'}});
async function test(name:string,run:()=>Promise<void>){await run();checks.push(name);}
function setup(options:{mediaType?:'application/pdf'|'image/png'|'image/jpeg';bytes?:Uint8Array;count?:number;countStatus?:number;malformedCount?:boolean;countFailure?:boolean;generationFailure?:boolean;disabled?:boolean;textOnly?:boolean;denyReserve?:boolean}={}){
 const events:string[]=[],bodies:Record<string,unknown>[]=[],settled:(number|undefined)[]=[],holds:number[]=[];
 const provider=createOpenAIProvider({model:'gpt-6.1-terra',apiKey:'offline-server-key-placeholder',spendingAuthorized:options.disabled!==true,pricing:OPENAI_EXPERIMENT_PRICING['gpt-6.1-terra'],requireResponseMetadata:true,
  ...(options.textOnly?{}:{originalAttachment:{filename:'synthetic.pdf',mediaType:options.mediaType??'application/pdf',bytes:options.bytes??pdf}}),
  async reserveBudget(usd){events.push('reserve');holds.push(usd);if(options.denyReserve)throw Error('offline cap');return {settle(actual?:number){events.push('settle');settled.push(actual);}};},
  async fetcher(url,init){const body=JSON.parse(String(init?.body));bodies.push(body);if(String(url).endsWith('/input_tokens')){events.push('count');if(options.countFailure)throw Error('offline count transport');return new Response(JSON.stringify(options.malformedCount?{input_tokens:'unknown'}:{object:'response.input_tokens',input_tokens:options.count??2000}),{status:options.countStatus??200});}assert.equal(String(url),'https://api.openai.com/v1/responses');events.push('generate');assert.equal(body.store,false);assert.equal(body.service_tier,'default');if(options.generationFailure)throw Error('offline uncertain');return response();}
 });return {provider,events,bodies,settled,holds};
}
await test('original PDF is pre-counted and reserved before actual bytes are sent inline without Files/public URLs',async()=>{const h=setup();await h.provider.step(request());assert.deepEqual(h.events,['count','reserve','generate','settle']);for(const body of h.bodies){const input=body.input as {content:Record<string,unknown>[]}[];const file=input[0].content.find(x=>x.type==='input_file')!;assert.equal(file.file_data,'data:application/pdf;base64,'+pdf.toString('base64'));assert.equal(file.file_url,undefined);assert.equal(file.file_id,undefined);}assert(h.holds[0]>2000*1.25/1e6);assert.equal(h.settled[0],.000045);});
await test('original image uses actual native image bytes and identical counted/generated input',async()=>{for(const mediaType of ['image/png','image/jpeg'] as const){const bytes=new Uint8Array([1,2,3]),h=setup({mediaType,bytes});await h.provider.step(request());assert.deepEqual(h.bodies[0].input,h.bodies[1].input);const body=JSON.stringify(h.bodies[1]);assert(body.includes('input_image'));assert(body.includes('data:'+mediaType+';base64,AQID'));assert(!body.includes('file_url'));}});
await test('failed or malformed counts cannot reserve or generate a response',async()=>{for(const options of [{countStatus:403},{countStatus:500},{malformedCount:true},{count:50001},{count:0},{countFailure:true}]){const h=setup(options);await assert.rejects(h.provider.step(request()));assert.deepEqual(h.events,['count']);assert.equal(h.holds.length,0);}});
await test('document cost bound and shared ledger refusal prevent generation',async()=>{const costly=setup({count:50000});await assert.rejects(costly.provider.step({...request(),remainingUsd:.001}));assert.deepEqual(costly.events,['count']);const denied=setup({denyReserve:true});await assert.rejects(denied.provider.step(request()));assert.deepEqual(denied.events,['count','reserve']);});
await test('uncertain generation retains the full reserved charge',async()=>{const h=setup({generationFailure:true});await assert.rejects(h.provider.step(request()));assert.deepEqual(h.events,['count','reserve','generate','settle']);assert.deepEqual(h.settled,[undefined]);assert(h.holds[0]>0);});
await test('ordinary conversational transport remains text-only without token-count endpoint',async()=>{const h=setup({textOnly:true});await h.provider.step(request());assert.deepEqual(h.events,['reserve','generate','settle']);assert.equal(typeof (h.bodies[0].input as {content:unknown}[])[0].content,'string');});
await test('disabled spending and invalid original size reject before all external calls',async()=>{const h=setup({disabled:true});await assert.rejects(h.provider.step(request()));assert.deepEqual(h.events,[]);for(const bytes of [new Uint8Array(),new Uint8Array(12000001)])assert.throws(()=>setup({bytes}),/invalid-original-attachment/);});
console.log(JSON.stringify({passed:true,groupsPassed:checks.length,checks,mode:'OFFLINE network and reservation doubles; original transport not a new live multimodal result',inferenceCalls:0,realCredentialReads:0}));
