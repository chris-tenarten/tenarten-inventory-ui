/** Focused failure/pagination/history regression, no model or database calls. */
import assert from 'node:assert/strict';
import {createContextFixture} from './support/tenbot-context-fixture.mjs';
import {resolveJobIntent,buildJobEvidence,renderJobEvidence} from '../supabase/functions/_shared/tenbot-job-routing';
import {prepareJobRequest} from '../supabase/functions/_shared/tenbot-job-session';
import {validOperationalReceipt,restoreOperationalHistory,OPERATIONAL_HISTORY_TTL} from '../supabase/functions/_shared/tenbot-operational-history';
import type {JobToolResult} from '../supabase/functions/_shared/tenbot-job-tools';
const checks:string[]=[];
const f=createContextFixture();f.tables.jobs[1].production_status='on_deck';f.tables.jobs[2].production_status='on_hold';
const first=await f.ask('How many Jobs are currently in Production?'),id=String(first.conversationId),a=await f.ask('Which Jobs are they?',id);assert(String(a.message).includes('CTX-1')&&!String(a.message).includes('CTX-2')&&!String(a.message).includes('CTX-3'));assert(!String(a.message).includes('No visible'));checks.push('they/them followups retain canonical current-status population rather than searching pronoun words');
const h=await f.run()({action:'history',conversationId:id}) as {turns:{answer:{history?:{historical:boolean};message:string}}[]};assert(h.turns.length===2&&h.turns.every(t=>t.answer.history?.historical));assert(h.turns.some(t=>t.answer.message===first.message));assert(f.row(id).state.operational?.length===2);assert(!JSON.stringify(f.row(id).state.operational).includes('total_hours'));checks.push('Readable answers survive server reopening; bounded display prose is separate from raw tool results and model context');
const receipt=structuredClone(f.row(id).state.operational![0]);assert(validOperationalReceipt(receipt));assert(!validOperationalReceipt({...receipt,rawToolResult:{jobs:[]}}));assert(!validOperationalReceipt({...receipt,expiresAt:new Date(Date.parse(receipt.answeredAt)+OPERATIONAL_HISTORY_TTL+1).toISOString()}));assert(!validOperationalReceipt({...receipt,reads:[{name:'sql',args:{},digest:'a'.repeat(64)}]}));checks.push('Receipt schema rejects arbitrary snapshots, SQL capabilities and retention extensions');
const context=f.row(id).state.context!,intent=resolveJobIntent('Which Jobs are they?',{jobId:'',continuity:context});assert(intent?.kind==='search');
const unavailable={tool:'find_jobs',version:'tenbot-job-read.v1',status:'unavailable',data:null,complete:false,truncated:false,unknowns:['Job reads unavailable'],filters:{},units:{},sources:[],observed_at:new Date().toISOString()} as unknown as JobToolResult;
const failure=await prepareJobRequest(intent,{execute:async()=>unavailable},'Which Jobs are they?');assert(!failure.message?.includes('No visible'));checks.push('Failed enumeration is a retrieval limitation, never a zero-Job assertion');
const emptyPage={...unavailable,status:'ok',complete:true,truncated:true,unknowns:[],data:{jobs:[],has_more:true,next_cursor:'20',match:'browse'}} as JobToolResult;let calls=0;const partial=await prepareJobRequest(intent,{execute:async()=>{calls++;return {...emptyPage,data:{...emptyPage.data as object,next_cursor:String(calls*20)}} as JobToolResult;}},'Which Jobs are they?');assert.equal(calls,3);assert(!partial.result?.complete&&partial.result?.truncated);assert(!String(partial.message).includes('No visible'));checks.push('Bounded incomplete pages explicitly remain partial; an empty filtered page cannot become zero Jobs');
const broken=await prepareJobRequest(intent,{execute:async()=>({...emptyPage,data:{...emptyPage.data as object,next_cursor:null}} as JobToolResult)},'Which Jobs are they?');assert(!broken.result?.complete);assert(!String(broken.message).includes('No visible'));checks.push('Missing pagination cursor fails closed as incomplete');
assert(!renderJobEvidence(buildJobEvidence({...emptyPage,status:'partial',complete:false})).includes('No visible'));const redacted=await restoreOperationalHistory([receipt],{execute:async()=>unavailable},f.state.now,receipt.scopeDigest,id,'assistant',async()=>true);assert(redacted.kept.length===0&&!JSON.stringify(redacted.turns).includes(receipt.message));checks.push('Revocation or unavailable evidence redacts retained text and question');
const {createTenbotAgentJobTools}=await import('../supabase/functions/_shared/tenbot-agent-operations');const scoped=createTenbotAgentJobTools(f.state.jobTools!,{intent,question:'Which Jobs are they?'});const modelSearch=await scoped.tools.find(t=>t.name==='find_jobs')!.execute({query:'are they'}, {callerId:f.owner,signal:new AbortController().signal});const serialized=JSON.stringify(modelSearch);assert(serialized.includes('CTX-1')&&!serialized.includes('CTX-2')&&!serialized.includes('CTX-3'));checks.push('Primary model-selected find_jobs receives the same retained population even when pronouns appear in its generated query');
const {createTenbotAgentSessions}=await import('../supabase/functions/_shared/tenbot-agent-session');const {createTenbotAgentHistoryStore}=await import('../supabase/functions/_shared/tenbot-agent-history-store');let step=0;const primary=createTenbotAgentSessions({readOnlyHosted:true,mode:'openai',sessionStore:createTenbotAgentHistoryStore(f.caller,f.service),can:async()=>true,jobTools:()=>f.state.jobTools!,now:()=>f.state.now,provider:()=>({name:'OFFLINE adversarial transport',model:'no-inference',async step(){step++;const usage={inputTokens:0,cachedInputTokens:0,outputTokens:0,costUsd:0,reservedUsd:0};if(step===1)return{calls:[{id:'discover',name:'discover_capabilities',arguments:{names:['find_jobs']}}],continuation:[],usage};if(step===2)return{calls:[{id:'read',name:'find_jobs',arguments:{query:'are they',include_archived:false,limit:20,cursor:''}}],continuation:[],usage};return{calls:[],continuation:[],usage,final:{answer:'No matching Jobs.',observations:[{text:'No matching Jobs.',evidence_ids:['e1']}],inferences:[],recommendations:[],questions:[],completed_actions:[]}};}})});const primaryReply=await primary({action:'ask',question:'Which Jobs are they?',conversationId:id},f.owner) as {message:string};assert(primaryReply.message.includes('CTX-1')&&!primaryReply.message.includes('CTX-2')&&!primaryReply.message.includes('No matching Jobs'));checks.push('Canonical scoped enumeration overrides a false-zero primary-model answer without a brittle prose filter');
const {operationalDigest}=await import('../supabase/functions/_shared/tenbot-operational-history');const fixtureResult={...unavailable,status:'ok',complete:true,data:null,unknowns:[]} as JobToolResult,proof=await operationalDigest(fixtureResult);const crowded=[0,1,2].map(i=>({...structuredClone(receipt),id:crypto.randomUUID(),createdAt:new Date(Date.parse(receipt.answeredAt)-3+i).toISOString(),reads:[0,1,2,3].map(j=>({name:'find_jobs' as const,args:{query:`scope-${i}-${j}`},digest:proof}))}));const bounded=await restoreOperationalHistory(crowded,{execute:async()=>fixtureResult},f.state.now,receipt.scopeDigest,id,'assistant',async()=>true);assert(bounded.kept.some(r=>r.id===crowded[2].id)&&!bounded.kept.some(r=>r.id===crowded[0].id));checks.push('Bounded verification prioritizes the newest answer; older receipts cannot starve or block a successful new turn');

const legacy=createTenbotAgentSessions({readOnlyHosted:true,operationalHistory:false,mode:'openai',sessionStore:createTenbotAgentHistoryStore(f.caller,f.service),can:async()=>true,jobTools:()=>f.state.jobTools!,now:()=>f.state.now,provider:()=>({name:'OFFLINE legacy compatibility',model:'no-inference',async step(){throw Error('offline provider unavailable');}}),fallback:async(_body,tools)=>{const r=await tools.execute('find_jobs',{query:'',include_archived:false,limit:20,cursor:''});return {message:'Legacy current answer',operational:true,sources:[],result:r};}});
const legacyAnswer=await legacy({action:'ask',question:'List current Production Jobs',conversationId:id},f.owner) as Record<string,unknown>;assert.equal(legacyAnswer.contentScope,'volatile');assert(!('historyTurns' in legacyAnswer)&&!('history' in legacyAnswer));
const legacyHistory=await legacy({action:'history',conversationId:id},f.owner) as {turns:{answer:{contentScope:string}}[]};assert(legacyHistory.turns.every(t=>t.answer.contentScope!=='operational-history'));assert(f.row(id).state.operational?.length);checks.push('Old Production client receives no new scope or live history while existing private TenDev receipts remain bounded');
const {readFileSync}=await import('node:fs');const hostedSource=readFileSync(new URL('../supabase/functions/_shared/tenbot-hosted.ts',import.meta.url),'utf8');assert(hostedSource.includes("operationalHistory:options.origin==='https://tendev.pages.dev'"));checks.push('Shared Edge opts only the staged TenDev origin into the new history display contract');
console.log(JSON.stringify({passed:true,groups:checks.length,checks,actualInference:false,actualDatabase:false},null,2));
