/** Focused direct-answer regression; real handlers/tools, synthetic Auth/data and
 * scripted transports. No live inference, database security or hosted claim. */
import assert from'node:assert/strict';import fs from'node:fs';
import {createContextFixture} from './support/tenbot-context-fixture.mjs';
import {resolveJobIntent} from '../supabase/functions/_shared/tenbot-job-routing';
import {createTenbotAgentSessions} from '../supabase/functions/_shared/tenbot-agent-session';
import {createTenbotAgentHistoryStore} from '../supabase/functions/_shared/tenbot-agent-history-store';
import type {AgentProvider,AgentStep} from '../supabase/functions/_shared/tenbot-agent';
const checks:string[]=[],examples:unknown[]=[],question='How many Jobs are currently In Production?',usage={inputTokens:0,cachedInputTokens:0,outputTokens:0,costUsd:0,reservedUsd:0};
const setup=()=>{const f=createContextFixture(),calls:{name:string;args:Record<string,unknown>}[]=[],real=f.state.jobTools!;f.state.jobTools={...real,async execute(name,args){calls.push({name,args});return real.execute(name,args);}};const ask=(q:string,id?:string)=>f.handler('https://tendev.pages.dev',{spendingAuthorized:false,persistentHistory:true})({action:'ask',question:q,...(id?{conversationId:id}:{})}) as Promise<{message:string;conversationId:string;fallback:boolean}>;return{...f,calls,ask};};
async function test(name:string,fn:()=>Promise<void>){await fn();checks.push(name);}
await test('Fresh and persisted named/legacy-pronoun searches cannot override an explicit count request',async()=>{for(const query of [null,'Context','that Job'])for(const direct of [question,'How many Jobs that are In Production are there?','Count Jobs in Production']){const f=setup(),id=query?(await f.ask('List Jobs for '+query)).conversationId:undefined,n=f.calls.length,b=await f.ask(direct,id);assert.match(b.message,/^There are 8 Jobs currently in Production\./);assert(f.calls.slice(n).some(r=>r.name==='get_production_overview'&&JSON.stringify(r.args.statuses)==='["in_production"]'));assert(!f.calls.slice(n).some(r=>r.name==='find_jobs'));assert.equal(f.row(b.conversationId).state.context?.selection.query,'');assert.equal(f.state.providerCalls,0);examples.push({priorQuery:query,message:b.message,calls:f.calls.slice(n)});}});
await test('A self-contained population request resets implicit archive/status scope while explicit selectors still apply',async()=>{const f=setup();f.tables.jobs[1].archived_at='2026-10-31T12:00:00Z';const a=await f.ask('List Jobs for Context including archived'),b=await f.ask(question,a.conversationId);assert.match(b.message,/^There are 7 Jobs currently in Production\./);assert.equal(f.row(b.conversationId).state.context!.selection.includeArchived,false);const c=await f.ask('How many Jobs are In Production including archived?',a.conversationId);assert.match(c.message,/^There are 8 Jobs currently in Production\./);assert.equal(f.row(c.conversationId).state.context!.selection.includeArchived,true);});
await test('Genuine referential or elliptical search continuations preserve their scope instead of inventing a global filtered count',async()=>{const f=setup(),a=await f.ask('List Jobs for Context'),seed=structuredClone(f.row(a.conversationId).state.context!),n=f.calls.length,b=await f.ask('How many of those are In Production?',a.conversationId);assert.match(b.message,/prior name\/customer search/);assert(!f.calls.slice(n).some(r=>r.name==='get_production_overview'));assert.equal(f.row(a.conversationId).state.context!.selection.query,'Context');const refined=resolveJobIntent('What about On Deck?',{jobId:'',continuity:seed});assert(refined?.kind==='search'||refined?.kind==='overview');if(refined.kind==='search')assert.equal(refined.args.query,'Context');});
await test('Count -> list -> status refinement -> schedule retains current references and can return to a new direct count',async()=>{const f=setup();f.tables.jobs[1].production_status='on_deck';const a=await f.ask(question);assert.match(a.message,/^There are 7 Jobs/);const b=await f.ask('Which ones?',a.conversationId);assert.match(b.message,/7 matching Jobs/);const c=await f.ask('What about On Deck?',a.conversationId);assert.match(c.message,/CTX-2/);const d=await f.ask('What are the scheduled dates for that Job?',a.conversationId);assert.match(d.message,/Planned: Oct 1, 2026–Nov 15, 2026/);await f.handler('https://tendev.pages.dev',{spendingAuthorized:false,persistentHistory:true})({action:'history',conversationId:a.conversationId});assert.match((await f.ask(question,a.conversationId)).message,/^There are 7 Jobs/);});
await test('An explicit count does not inherit ambiguity from a previous multi-Job detail set',async()=>{const f=setup();f.tables.jobs[1].production_status='on_deck';f.tables.jobs[2].production_status='on_deck';const a=await f.ask('List On Deck Jobs');await f.ask('Show the scheduled dates for those Jobs',a.conversationId);assert.equal(f.row(a.conversationId).state.context!.references.length,2);const b=await f.ask(question,a.conversationId);assert.match(b.message,/^There are 6 Jobs/);});
async function primary(mode:'ok'|'unavailable'|'partial'|'missing-number'|'zero'){
 const f=setup();if(mode==='zero')f.tables.jobs.forEach(j=>j.production_status='complete');const first=await f.ask('List Jobs for Context'),original=f.state.jobTools!;if(['unavailable','partial','missing-number'].includes(mode))f.state.jobTools={...original,async execute(name,args){const r=await original.execute(name,args);if(name!=='get_production_overview')return r;return mode==='missing-number'&&r.data&&'upcoming' in r.data?{...r,data:{...r.data,counts:{...r.data.counts,jobs:null}}}:{...r,status:mode==='partial'?'partial':'unavailable',complete:false,data:mode==='unavailable'?null:r.data};}};
 let round=0;const provider:AgentProvider={name:'OFFLINE answer transport',model:'no-inference',async step(){round++;if(round===1)return{calls:[{id:'d',name:'discover_capabilities',arguments:{names:['get_production_overview']}}],continuation:[],usage};if(round===2)return{calls:[{id:'o',name:'get_production_overview',arguments:{statuses:[],include_archived:true,start_date:'',end_date:'',limit:20}}],continuation:[],usage};return{calls:[],continuation:[],usage,final:{answer:'Overview counts describe lifecycle and archive populations; search results describe name matches.',observations:[{text:'Overview counts describe lifecycle and archive populations; search results describe name matches.',evidence_ids:['e1']}],inferences:[],recommendations:[],questions:[],completed_actions:[]}} as AgentStep;}};
 const run=createTenbotAgentSessions({readOnlyHosted:true,mode:'openai',sessionStore:createTenbotAgentHistoryStore(f.caller,f.service,{persistent:true}),can:async()=>f.state.allowed,jobTools:()=>f.state.jobTools!,now:()=>f.state.now,provider:()=>provider});const reply=await run({action:'ask',question,conversationId:first.conversationId},f.owner) as {message:string};return{reply,f,round};
}
await test('Successful primary quantitative output leads with the exact authorized answer even when generated prose explains semantics',async()=>{const {reply,f,round}=await primary('ok');assert.match(reply.message,/^There are 8 Jobs currently in Production\./);assert(!reply.message.includes('name matches'));assert.equal(round,3);assert(f.calls.some(r=>r.name==='get_production_overview'&&r.args.include_archived===false&&JSON.stringify(r.args.statuses)==='["in_production"]'));});
await test('Unavailable/incomplete results and missing numeric fields never become invented totals or scope-only prose; a real zero remains zero',async()=>{for(const mode of ['unavailable','partial','missing-number'] as const){const {reply}=await primary(mode);assert.match(reply.message,/unavailable|incomplete|cannot give an exact/i);assert(!/^There (?:are|is) \d/.test(reply.message));assert(!reply.message.includes('name matches'));}assert.match((await primary('zero')).reply.message,/^There are 0 Jobs currently in Production\./);});
await test('Current authorization changes still deny publication rather than returning a previously read count',async()=>{const f=setup(),a=await f.ask('List Jobs for Context'),original=f.state.jobTools!;let changed=false;f.state.jobTools={...original,async execute(name,args){const r=await original.execute(name,args);if(name==='get_production_overview'&&!changed){changed=true;f.hidden.add(f.tables.jobs[0].id);}return r;}};await assert.rejects(f.ask(question,a.conversationId),/access|underlying records changed/i);});
const result={passed:true,groups:checks.length,checks,examples,actualCode:true,syntheticDatabaseAndAuth:true,actualDatabase:false,actualInference:false,hostedRequests:0,operationalWrites:0};const out=process.env.TENBOT_DIRECT_EVIDENCE;if(out)fs.writeFileSync(out,JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result,null,2));
