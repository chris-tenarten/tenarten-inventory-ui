import assert from 'node:assert/strict';
import {writeFileSync} from 'node:fs';
import {mobileProductionRows} from '../src/modules/production/mobile-timeline-adapter';
import {mobileBidRows} from '../src/modules/pre-production/mobile-timeline-adapter';
import {normalizePlanning,planningForMode} from '../src/modules/pre-production/planning-model';
