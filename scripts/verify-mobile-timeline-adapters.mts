import type {PlanningPhase} from '../src/modules/planning/types';
import type {Bid} from '../src/modules/pre-production/types';
const j=jobs as unknown as ProductionJob[],p=phases as unknown as PlanningPhase[],b=bids as Bid[],checks:string[]=[];
const snapshot=JSON.stringify({jobs,phases,bids,windows});
let opened='';let rows=mobileProductionRows(j,{},p,{},job=>{opened=job.id;});
assert.equal(rows.length,j.length);assert.equal(rows.find(r=>r.key===j[0].id)?.title,j[0].name);rows.find(r=>r.key===j[0].id)!.open();assert.equal(opened,j[0].id);checks.push('Production identity and module-owned editor callback');
assert(rows.find(r=>r.key===j[26].id)?.markers.some(m=>m.id==='requested-delivery'));assert(!rows.find(r=>r.key===j[0].id)?.markers.some(m=>m.id==='requested-delivery'));checks.push('Requested delivery only without a complete Production schedule');
assert.equal(rows.find(r=>r.key===j[0].id)?.markers.find(m=>m.id==='review-phase-0-b')?.visual?.backgroundImage,PLANNING_PAUSE_HATCH);assert(!rows.flatMap(r=>r.markers).some(m=>m.id==='review-planning-only'));checks.push('Production phase palette, pause hatch and planning-only exclusion');
const normalized=normalizePlanning(b,windows,j,p);let bidRows=mobileBidRows(planningForMode(normalized,'intake'),bid=>{opened=bid.id;});assert.equal(bidRows.length,12);assert(!bidRows.some(r=>r.key.endsWith(b[12].id)||r.key.endsWith(b[13].id)));bidRows[0].open();assert(opened.startsWith('review-bid-'));assert(bidRows.every(r=>r.projected));checks.push('Existing Bid eligibility and module-owned callback; no canonical Job fabrication');
const combined=mobileBidRows(planningForMode(normalized,'combined'),()=>{});assert.equal(combined.length,40);assert(combined.some(r=>r.markers.some(m=>m.id==='review-planning-only')));assert(combined.filter(r=>!r.projected).every(r=>r.status.includes('View in Production')));checks.push('Combined references retain lifecycle keys and read-only Production context');
const selected={record:j[0]},first=stageProduction({},{},selected,day(-2),day(6),p,j);const second=stageProduction(first.staged,first.stagedPhases,selected,day(-1),day(7),p,j);rows=mobileProductionRows(j,second.staged,p,second.stagedPhases,()=>{});assert.equal(rows.find(r=>r.key===j[0].id)?.start,day(-1));assert(rows.find(r=>r.key===j[0].id)?.staged);assert.equal(rows.find(r=>r.key===j[0].id)?.markers.find(m=>m.id===p[0].id)?.start,day(1));checks.push('Presenter consumes existing repeated incremental staging and phase translation');
assert.equal(JSON.stringify({jobs,phases,bids,windows}),snapshot);checks.push('Adapters do not mutate records, schedules, phases or Bid projections');
writeFileSync('docs/mobile-early-access/adapters.json',JSON.stringify({checks,passed:true},null,2));console.log(checks.join('\n'));
